EXPO_PUBLIC_API_BASE=https://omniwx-api.omniwx.workers.dev
EXPO_PUBLIC_OMNIWX_API_BASE=https://omniwx-api.omniwx.workers.dev
EXPO_PUBLIC_MAPTILER_API_KEY=

# Cloudflare R2 S3-compatible upload credentials for local/scheduled MRMS jobs.
# These are Cloudflare keys, not an AWS account. Keep real values only in .env
# or your scheduler secret store.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
