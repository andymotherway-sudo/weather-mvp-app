<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/omniwx_widget_background"
  android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AIRPORT WEATHER BOARD"
        android:textColor="#7dd3fc"
        android:textSize="10sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_station"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="K---"
        android:textColor="#ffffff"
        android:textSize="26sp"
        android:textStyle="bold" />
    </LinearLayout>

    <TextView
      android:id="@+id/widget_category"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/omniwx_widget_chip"
      android:text="--"
      android:textColor="#ffffff"
      android:textSize="18sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/widget_airport_name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Airport name"
    android:textColor="#a1a1aa"
    android:textSize="13sp"
    android:textStyle="bold" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/omniwx_widget_panel"
    android:orientation="vertical">

    <TextView
      android:id="@+id/widget_status_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Status"
      android:textColor="#ffffff"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_status_summary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:text="Current METAR summary"
      android:textColor="#dbeafe"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>

  <GridLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:layout_weight="1"
    android:columnCount="2"
    android:rowCount="2">

    <TextView
      android:id="@+id/widget_wind"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_columnWeight="1"
      android:layout_rowWeight="1"
      android:background="@drawable/omniwx_widget_panel"
      android:text="WIND\n--"
      android:textColor="#f8fafc"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_visibility"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_columnWeight="1"
      android:layout_marginStart="8dp"
      android:layout_rowWeight="1"
      android:background="@drawable/omniwx_widget_panel"
      android:text="VIS\n--"
      android:textColor="#f8fafc"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_ceiling"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_columnWeight="1"
      android:layout_marginTop="8dp"
      android:layout_rowWeight="1"
      android:background="@drawable/omniwx_widget_panel"
      android:text="CEILING\n--"
      android:textColor="#f8fafc"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_altimeter"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_columnWeight="1"
      android:layout_marginStart="8dp"
      android:layout_marginTop="8dp"
      android:layout_rowWeight="1"
      android:background="@drawable/omniwx_widget_panel"
      android:text="ALTIMETER\n--"
      android:textColor="#f8fafc"
      android:textSize="12sp"
      android:textStyle="bold" />
  </GridLayout>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/omniwx_widget_divider"
    android:text="" />

  <TextView
    android:id="@+id/widget_footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Situational awareness only."
    android:textColor="#cbd5e1"
    android:textSize="10sp" />
</LinearLayout>
