<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/omniwx_widget_background"
  android:orientation="vertical">

  <TextView
    android:id="@+id/widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="OMNIwx"
    android:textColor="#e0f2fe"
    android:textSize="13sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/widget_primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:text="--F"
    android:textColor="#ffffff"
    android:textSize="34sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/widget_secondary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Open OMNIwx to refresh"
    android:textColor="#cbd5e1"
    android:textSize="12sp" />

  <TextView
    android:id="@+id/widget_tertiary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Wind --"
    android:textColor="#93c5fd"
    android:textSize="12sp" />

  <TextView
    android:id="@+id/widget_footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Last updated --"
    android:textColor="#94a3b8"
    android:textSize="10sp" />
</LinearLayout>
