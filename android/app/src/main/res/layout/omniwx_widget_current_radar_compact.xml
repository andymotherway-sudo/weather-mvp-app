<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/omniwx_widget_background">
  <ImageView android:id="@+id/widget_radar" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="centerCrop" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:gravity="bottom" android:orientation="vertical">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="OMNIwx" android:textColor="#e0f2fe" android:textSize="10sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
      <ImageView android:id="@+id/widget_icon" android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="@null" />
      <TextView android:id="@+id/widget_temp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:includeFontPadding="false" android:text="--" android:textColor="#ffffff" android:textSize="30sp" android:textStyle="bold" />
      <TextView android:id="@+id/widget_refresh" android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/omniwx_widget_chip" android:gravity="center" android:text="&#8635;" android:textColor="#ffffff" android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_detail" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <LinearLayout android:id="@+id/widget_range_line" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_condition" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_phrase" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_wind" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_low" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_range" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_high" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_footer" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
</FrameLayout>
