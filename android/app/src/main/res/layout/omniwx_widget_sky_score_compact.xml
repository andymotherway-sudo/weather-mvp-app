<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/omniwx_widget_background"
  android:gravity="center"
  android:orientation="vertical">
  <TextView
    android:id="@+id/widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:gravity="center"
    android:maxLines="1"
    android:text="OMNIwx"
    android:textColor="#e0f2fe"
    android:textSize="10sp"
    android:textStyle="bold" />
  <FrameLayout
    android:layout_width="76dp"
    android:layout_height="76dp"
    android:layout_marginTop="2dp">
    <ImageView android:id="@+id/widget_score_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
      <TextView android:id="@+id/widget_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="--" android:textColor="#ffffff" android:textSize="27sp" android:textStyle="bold" />
      <TextView android:id="@+id/widget_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Sky Score" android:textColor="#86efac" android:textSize="9sp" android:textStyle="bold" />
    </LinearLayout>
  </FrameLayout>
  <TextView android:id="@+id/widget_chip" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_best_window" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_tertiary" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <LinearLayout android:id="@+id/widget_cloud_grid" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_cloud_low" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_cloud_mid" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_cloud_high" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_divider" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/widget_footer" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
</LinearLayout>
