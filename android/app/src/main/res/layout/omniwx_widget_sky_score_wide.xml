<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/omniwx_widget_background"
  android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="OMNIwx  •  SKY SCORE"
      android:textColor="#93c5fd"
      android:textSize="10sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/widget_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="Tonight"
      android:textColor="#f8fafc"
      android:textSize="13sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/widget_chip"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/omniwx_widget_chip"
      android:text="SPACE"
      android:textColor="#ffffff"
      android:textSize="9sp"
      android:textStyle="bold" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <FrameLayout
      android:layout_width="92dp"
      android:layout_height="92dp">
      <ImageView
        android:id="@+id/widget_score_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
          android:id="@+id/widget_primary"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:includeFontPadding="false"
          android:text="--"
          android:textColor="#ffffff"
          android:textSize="30sp"
          android:textStyle="bold" />
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Sky Score"
          android:textColor="#e5e7eb"
          android:textSize="9sp"
          android:textStyle="bold" />
      </LinearLayout>
    </FrameLayout>
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="vertical">
      <TextView
        android:id="@+id/widget_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Quality --"
        android:textColor="#f8fafc"
        android:textSize="15sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/widget_best_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Best window --"
        android:textColor="#86efac"
        android:textSize="11sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/widget_tertiary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Bortle --"
        android:textColor="#c4b5fd"
        android:textSize="10sp" />
    </LinearLayout>
  </LinearLayout>

  <GridLayout
    android:id="@+id/widget_cloud_grid"
    android:layout_width="match_parent"
    android:layout_height="30dp"
    android:layout_marginTop="5dp"
    android:columnCount="3">
    <TextView android:id="@+id/widget_cloud_low" android:layout_width="0dp" android:layout_height="match_parent" android:layout_columnWeight="1" android:background="@drawable/omniwx_widget_panel" android:gravity="center" android:text="LOW --" android:textColor="#e0f2fe" android:textSize="8sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_cloud_mid" android:layout_width="0dp" android:layout_height="match_parent" android:layout_columnWeight="1" android:layout_marginStart="5dp" android:background="@drawable/omniwx_widget_panel" android:gravity="center" android:text="MID --" android:textColor="#e0f2fe" android:textSize="8sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_cloud_high" android:layout_width="0dp" android:layout_height="match_parent" android:layout_columnWeight="1" android:layout_marginStart="5dp" android:background="@drawable/omniwx_widget_panel" android:gravity="center" android:text="HIGH --" android:textColor="#e0f2fe" android:textSize="8sp" android:textStyle="bold" />
  </GridLayout>
  <TextView android:id="@+id/widget_divider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="5dp" android:background="@drawable/omniwx_widget_divider" android:text="" />
  <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="Updated --" android:textColor="#86efac" android:textSize="8sp" />
</LinearLayout>
