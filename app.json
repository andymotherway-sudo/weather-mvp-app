{
  "expo": {
    "name": "OMNIwx Alpha",
    "slug": "weather-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-alpha.png",
    "scheme": "weatherapp",
    "androidStatusBar": {
      "backgroundColor": "#020617",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#020617",
      "barStyle": "light-content"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
      "package": "com.anonymous.weatherapp",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/brand/android-foreground-alpha.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-alpha.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#020617",
          "dark": {
            "backgroundColor": "#020617"
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "apiBaseUrl": "https://omniwx-api.omniwx.workers.dev",
      "eas": {
        "projectId": "80344024-cac1-4b5a-9ab7-24c20b41cdf3"
      }
    }
  }
}
