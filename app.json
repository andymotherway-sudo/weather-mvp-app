{
  "expo": {
    "name": "OMNIwx Alpha",
    "slug": "weather-app",
    "version": "1.1.42",
    "owner": "andymotherway",
    "orientation": "default",
    "icon": "./assets/brand/icon-alpha.png",
    "scheme": "weatherapp",
    "androidStatusBar": {
      "backgroundColor": "#020617",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#020617",
      "barStyle": "light-content"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.omniwx.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "OMNIwx uses your location to show local weather, radar, and marine conditions for your current area."
      }
    },
    "android": {
      "package": "com.anonymous.weatherapp",
      "versionCode": 10050,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/brand/android-foreground-alpha.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-alpha.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#020617",
          "dark": {
            "backgroundColor": "#020617"
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "apiBaseUrl": "https://omniwx-api.omniwx.workers.dev",
      "supportUrl": "https://www.omni-wx.com/support",
      "privacyPolicyUrl": "https://www.omni-wx.com/privacy",
      "buildLabel": "almanac-aab-test-1",
      "eas": {
        "projectId": "80344024-cac1-4b5a-9ab7-24c20b41cdf3",
        "almanacSafeMode": true
      }
    }
  }
}
