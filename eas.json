{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://omniwx-api.omniwx.workers.dev",
        "EXPO_PUBLIC_OMNIWX_API_BASE": "https://omniwx-api.omniwx.workers.dev"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://omniwx-api.omniwx.workers.dev",
        "EXPO_PUBLIC_OMNIWX_API_BASE": "https://omniwx-api.omniwx.workers.dev"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://omniwx-api.omniwx.workers.dev",
        "EXPO_PUBLIC_OMNIWX_API_BASE": "https://omniwx-api.omniwx.workers.dev"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "autoIncrement": "buildNumber"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
